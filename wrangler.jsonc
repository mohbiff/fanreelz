// Fanreelz on Cloudflare Workers (static site + functions + schedules). Netlify keeps working from netlify.toml.
{
  "name": "fanreelz",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // the Worker handles the functions and the pages that get their own title and preview; icons and other files go straight out
    "run_worker_first": ["/api/*", "/", "/film/*", "/shorts", "/shorts/*", "/c/*", "/showdown", "/showdown/*", "/sitemap.xml", "/about", "/browse", "/battles", "/requests", "/discord", "/live", "/playlists"]
  },
  "triggers": { "crons": ["17 * * * *", "41 * * * *"] },
  "vars": { "IMPORT_CHANNELS": "3" },
  // keep the settings added in the Cloudflare dashboard when the site is published again
  "keep_vars": true,
  "observability": { "enabled": true }
}
